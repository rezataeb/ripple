# Ripple needs NO keys. With these empty it runs in demo mode: template answers and a cached,
# clearly labelled sample market scan.
#
# To turn on live Ask Ripple you need ONE key: GEMINI_API_KEY (Google AI Studio has a free tier).
# NIMBLE_API_KEY is optional and not needed: it only swaps the cached sample competitor prices
# for a live web search.
#
# After adding a key, set DEMO_MODE=0 (DEMO_MODE=1 forces demo mode even when keys are present).
# Never commit .env.

GEMINI_API_KEY=
# optional; defaults to gemini-2.5-flash
GEMINI_MODEL=
# optional; defaults to gemini-embedding-001
GEMINI_EMBED_MODEL=
# optional
NIMBLE_API_KEY=
DEMO_MODE=1
